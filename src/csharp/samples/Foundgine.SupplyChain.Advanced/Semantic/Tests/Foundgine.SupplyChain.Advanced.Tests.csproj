<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Mcp_transport_* posts real JSON-RPC to /mcp, so the tests host the real MCP server. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <ProjectReference Include="../Foundgine.SupplyChain.Advanced.csproj" />
    <!-- Adapter tests exercise the actual MCP and Hot Chocolate resolver types. -->
    <ProjectReference Include="../Api/Mcp/Foundgine.SupplyChain.Advanced.Mcp.Api.csproj" />
    <ProjectReference Include="../../../../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../../../../Foundgine.Extensions.GraphQL/Foundgine.Extensions.GraphQL.csproj" />
    <!-- Needed only by CapabilityBoundaryTests, which pins the Step 37
         execution-boundary invariant against a real provider (InMemory)
         instead of the semantic/planning layer the rest of this project
         exercises. Foundgine.Core.Execution and Foundgine.Core.Semantic.Planning come in
         transitively through this reference. -->
    <ProjectReference Include="../../../../Foundgine.Providers/Foundgine.Providers.csproj" />
    <!-- Needed only by the Retrieval/* tests, which exercise
         PostgresRetrievalCandidateSource (Fuzzy/pg_trgm, FullText,
         Search/pg_search, GraphSimilarity/Apache AGE, and the reserved
         Vector strategy) against the Supply Chain semantic model. -->
  </ItemGroup>
</Project>
